[Unit]
Description=Dotmac Mailcow SOGo forwarding cleanup processor
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dotmac-sogo-cleanup.env
ExecStart=/opt/dotmac-mailcow-offboarding/sogo_forward_cleanup.py --config /etc/dotmac-sogo-cleanup.env --apply
