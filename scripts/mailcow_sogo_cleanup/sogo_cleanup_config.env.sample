# Shared local SQLite queue used by the receiver and cleanup processor.
QUEUE_DB=/var/lib/dotmac-mailcow-offboarding/sogo_cleanup_queue.sqlite3
ALLOWED_DOMAINS=dotmac.ng
CLEANUP_BATCH_SIZE=100

# Mailcow Docker Compose installation. MariaDB remains private to Mailcow.
MAILCOW_DIR=/opt/mailcow-dockerized
DOCKER_BIN=docker
MYSQL_SERVICE=mysql-mailcow
SOGO_RESTART_SERVICES=sogo-mailcow,memcached-mailcow

# Private cleanup request receiver. Replace the token before starting it.
CLEANUP_RECEIVER_HOST=127.0.0.1
CLEANUP_RECEIVER_PORT=8765
CLEANUP_RECEIVER_TOKEN=
