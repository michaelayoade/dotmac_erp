# Dedicated locked-password account, with a normal shell solely for forced command.
# Requires independently checked effective global PermitUserEnvironment=no.
# PermitUserEnvironment is not allowed inside Match; refuse enrollment otherwise.
Match User erp-proof
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PermitTTY no
    DisableForwarding yes
    PermitUserRC no
    ForceCommand /usr/local/libexec/dotmac-erp-proof-launcher
